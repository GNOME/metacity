#: libmetacity/meta-color-spec.c:246
#, c-format
msgid ""
"GTK custom color specification must have color name and fallback in "
"parentheses, e.g. gtk:custom(foo,bar); could not parse '%s'"
msgstr ""
"Згодна са спецыфікацыяй GTK для карыстальніцкага колеру, павінны быць назва "
"колеру і ў дужках рэзервовы варыянт, напр. gtk:custom(foo,bar); не ўдалося "
"разабраць «%s»"

#: libmetacity/meta-color-spec.c:260
#, c-format
msgid ""
"Invalid character '%c' in color_name parameter of gtk:custom, only A-Za-z0-9-"
"_ are valid"
msgstr ""
"Памылковы сімвал «%c» у параметры color_name ключа gtk:custom, можна "
"выкарыстоўваць толькі A-Za-z0-9-_"

#: libmetacity/meta-color-spec.c:277
#, c-format
msgid ""
"Gtk:custom format is 'gtk:custom(color_name,fallback)', '%s' does not fit "
"the format"
msgstr ""
"Фармат gtk:custom — «gtk:custom(color_name,fallback)», «%s» не адпавядае "
"фармату"

#: libmetacity/meta-color-spec.c:310
#, c-format
msgid ""
"GTK color specification must have the state in brackets, e.g. gtk:fg[NORMAL] "
"where NORMAL is the state; could not parse '%s'"
msgstr ""
"Згодна са спецыфікацыяй колеру GTK у дужках павінен быць стан, напр. "
"gtk:fg[NORMAL], дзе NORMAL — гэта стан. Не ўдалося разабраць «%s»"

#: libmetacity/meta-color-spec.c:323
#, c-format
msgid ""
"GTK color specification must have a close bracket after the state, e.g. "
"gtk:fg[NORMAL] where NORMAL is the state; could not parse '%s'"
msgstr ""
"Згодна са спецыфікацыяй колеру GTK пасля стану павінна быць закрывальная "
"дужка, напрыклад, gtk:fg[NORMAL], дзе NORMAL - гэта стан. Не ўдалося "
"разабраць «%s»"

#: libmetacity/meta-color-spec.c:332
#, c-format
msgid "Did not understand state '%s' in color specification"
msgstr "Незразумелы стан «%s» у спецыфікацыі колеру"

#: libmetacity/meta-color-spec.c:344
#, c-format
msgid "Did not understand color component '%s' in color specification"
msgstr "Незразумелы складнік колеру «%s» у спецыфікацыі колеру"

#: libmetacity/meta-color-spec.c:370
#, c-format
msgid ""
"Blend format is 'blend/bg_color/fg_color/alpha', '%s' does not fit the format"
msgstr ""
"Фармат змяшанага колеру - «blend/bg_color/fg_color/alpha». «%s» не адпавядае "
"фармату"

#: libmetacity/meta-color-spec.c:380
#, c-format
msgid "Could not parse alpha value '%s' in blended color"
msgstr "Не ўдалося разабраць значэнне альфа-канала «%s» ў змяшаным колеры"

#: libmetacity/meta-color-spec.c:389
#, c-format
msgid "Alpha value '%s' in blended color is not between 0.0 and 1.0"
msgstr ""
"Значэнне альфа-канала «%s» у змяшаным колеры не знаходзіцца ў дыяпазоне ад "
"0.0 да 1.0"

#: libmetacity/meta-color-spec.c:432
#, c-format
msgid "Shade format is 'shade/base_color/factor', '%s' does not fit the format"
msgstr "Фармат ценю — «shade/base_color/factor». «%s» не адпавядае фармату"

#: libmetacity/meta-color-spec.c:442
#, c-format
msgid "Could not parse shade factor '%s' in shaded color"
msgstr "Не ўдалося разабраць каэфіцыент ценю «%s» у зацененым колеры"

#: libmetacity/meta-color-spec.c:451
#, c-format
msgid "Shade factor '%s' in shaded color is negative"
msgstr "Каэфіцыент ценю «%s» у зацененым колеры адмоўны"

#: libmetacity/meta-color-spec.c:477
#, c-format
msgid "Could not parse color '%s'"
msgstr "Не ўдалося разабраць колер «%s»"

#: libmetacity/meta-draw-spec.c:201
#, c-format
msgid "Coordinate expression contains character '%s' which is not allowed"
msgstr "Каардынатны выраз змяшчае забаронены сімвал «%s»"

#: libmetacity/meta-draw-spec.c:228
#, c-format
msgid ""
"Coordinate expression contains floating point number '%s' which could not be "
"parsed"
msgstr "Каардынатны выраз змяшчае незразумелы лік з нефіксаванай коскай «%s»"

#: libmetacity/meta-draw-spec.c:241
#, c-format
msgid "Coordinate expression contains integer '%s' which could not be parsed"
msgstr "Каардынатны выраз змяшчае незразумелы цэлы лік «%s»"

#: libmetacity/meta-draw-spec.c:368
#, c-format
msgid ""
"Coordinate expression contained unknown operator at the start of this text: "
"\"%s\""
msgstr ""
"Каардынатны выраз змяшчае невядомы аператар у пачатку гэтага тэксту: «%s»"

#: libmetacity/meta-draw-spec.c:424
msgid "Coordinate expression was empty or not understood"
msgstr "Каардынатны выраз пусты або незразумелы"

#: libmetacity/meta-draw-spec.c:586
#, c-format
msgid "Coordinate expression had unknown variable or constant '%s'"
msgstr "Каардынатны выраз змяшчае невядомую пераменную або канстанту «%s»"

#: libmetacity/meta-draw-spec.c:638 libmetacity/meta-draw-spec.c:648
#: libmetacity/meta-draw-spec.c:683 libmetacity/meta-draw-spec.c:693
msgid "Coordinate expression results in division by zero"
msgstr "Каардынатны выраз прыводзіць да дзялення на нуль"

#: libmetacity/meta-draw-spec.c:782
#, c-format
msgid ""
"Coordinate expression has an operator \"%s\" where an operand was expected"
msgstr "Каардынатны выраз змяшчае аператар «%s» там, дзе павінен быць аперанд"

#: libmetacity/meta-draw-spec.c:791
